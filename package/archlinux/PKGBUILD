# 来源: https://aur.archlinux.org/packages/splayer-next-git (有修改)
# 感谢 InubashiriLix

pkgname=splayer-next-mo-git
pkgver=0.0.0.r0.g0000000
pkgrel=1
pkgdesc='私房菜 😋'

url='https://github.com/MoYingJi/SPlayer-Next'
_branch='dev-mo'
_electron_version='43.2.0'
_electron_major="${_electron_version%%.*}"

_ffmpeg_audio_sys_version="0.1.2"

arch=('x86_64' 'aarch64')
license=('AGPL-3.0-only')

provides=("splayer-next=${pkgver}")
conflicts=('splayer-next')

depends=(
    "electron${_electron_major}"
    'hicolor-icon-theme' # 图标
    'alsa-lib' # 音频引擎
    'ffmpeg' # 音频引擎
    'fontconfig' # font-list 会调用 fc-list
)
optdepends=(
    'xdg-utils: 打开外部链接'
    'dbus: MPRIS 媒体控制支持'
    'libpulse: PulseAudio 音频后端和捕获音频 (听歌识曲功能)'
    'pipewire: PipeWire 音频后端'
)
makedepends=(
    'git'
    'nodejs>=22.19.0'
    'pnpm>=10'
    'rust'
    'clang'
    'cmake'
    'libpulse' # 编译 audio-engine audio-capture
    'pipewire' # 编译 audio-engine
)

# Rust 工作区已经启用了 LLVM LTO
# makepkg 的 GCC LTO 标志会生成静态 C/C++ 归档，而 rustc 在最终 N-API 模块中会留下未解析符号
# 原生模块必须被 strip，但单独的 debug 包会大得难以接受
options=('!debug' '!lto')

_source='SPlayer-Next-git'

source=(
    "${_source}::git+${url}.git#branch=${_branch}"
    "ffmpeg_audio_sys.crate::https://static.crates.io/crates/ffmpeg_audio_sys/ffmpeg_audio_sys-${_ffmpeg_audio_sys_version}.crate"
    'splayer-next.sh'
    'top.imsyy.splayer_next.desktop'
    'ffmpeg-system.patch'
)
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
)

pkgver() {
    cd "$_source"

    local upstream_version
    upstream_version="$(node -p "require('./package.json').version")"

    printf '%s.r%s.g%s' \
        "${upstream_version//-/_}" \
        "$(git rev-list --count HEAD)" \
        "$(git rev-parse --short=7 HEAD)"
}

_setup_build_env() {
    export PNPM_HOME="$srcdir/pnpm-home"
    export npm_config_cache="$srcdir/npm-cache"
    export XDG_CACHE_HOME="$srcdir/xdg-cache"

    export ELECTRON_CACHE="$srcdir/electron-cache"
    export ELECTRON_BUILDER_CACHE="$srcdir/electron-builder-cache"
    export ELECTRON_SKIP_BINARY_DOWNLOAD=1

    export CARGO_HOME="$srcdir/cargo-home"
    export CARGO_TARGET_DIR="$srcdir/cargo-target"

    export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
    export FFMPEG_MODE=system

    mkdir -p \
        "$PNPM_HOME" \
        "$npm_config_cache" \
        "$XDG_CACHE_HOME" \
        "$ELECTRON_CACHE" \
        "$ELECTRON_BUILDER_CACHE" \
        "$CARGO_HOME" \
        "$CARGO_TARGET_DIR"
}

prepare() {
    _setup_build_env

    cd "$_source"

    local upstream_electron_version
    upstream_electron_version="$(
      node -p "require('./package.json').devDependencies.electron" \
        | tr -d '^~'
    )"

    sed -i -e "
        s/@electron_major@/$_electron_major/g
    " "$srcdir/splayer-next.sh"

    sed -i -e "
        s/@pkgdesc@/${pkgdesc}/g
    " "$srcdir/top.imsyy.splayer_next.desktop"

    patch -d "$srcdir/ffmpeg_audio_sys-${_ffmpeg_audio_sys_version}" -Np1 -i "$srcdir/ffmpeg-system.patch"
    cat >> Cargo.toml <<EOF
[patch.crates-io]
ffmpeg_audio_sys = { path = "$srcdir/ffmpeg_audio_sys-${_ffmpeg_audio_sys_version}" }
EOF

    pnpm install \
        --frozen-lockfile \
        --ignore-scripts \
        --store-dir "$srcdir/pnpm-store"
}

build() {
    _setup_build_env

    cd "$_source"

    local electron_version
    electron_version=$(<"/usr/lib/electron${_electron_major}/version")
    electron_version=${electron_version#v}

    pnpm build:native

    # Linux 允许共享库中存在未解析的符号
    # 与其发布一个仅在 Electron 加载时才会出错的模块，不如在此处构建失败
    if nm -D --undefined-only native/audio-engine/audio-engine.node |
        grep -Eq 'signalsmith_stretch_|aws_lc_[0-9_]+_'; then
        printf '%s\n' 'audio-engine.node contains unresolved bundled-library symbols' >&2
        return 1
    fi

    SKIP_NATIVE_BUILD=true pnpm build
    pnpm exec electron-builder \
        --linux \
        --x64 \
        --dir \
        --publish never \
        --config electron-builder.config.ts \
        -c.electronDist="/usr/lib/electron${_electron_major}" \
        -c.electronVersion="$electron_version"

    test -f dist/linux-unpacked/resources/app.asar
    test -d dist/linux-unpacked/resources/app.asar.unpacked
    test -f dist/linux-unpacked/resources/native/audio-engine.node
    test -f dist/linux-unpacked/resources/native/media-ctrl.node
}

check() {
    cd "$_source"

    # 使用运行时使用的确切 Electron 主版本号加载每个原生模块
    env ELECTRON_RUN_AS_NODE=1 "/usr/lib/electron${_electron_major}/electron" -e \
        "require(process.argv[1])" \
        "$PWD/native/audio-engine/audio-engine.node"
    env ELECTRON_RUN_AS_NODE=1 "/usr/lib/electron${_electron_major}/electron" -e \
        "require(process.argv[1])" \
        "$PWD/native/media-ctrl/media-ctrl.node"
    env ELECTRON_RUN_AS_NODE=1 "/usr/lib/electron${_electron_major}/electron" -e "
        const Database=require(process.argv[1]);
        const db=new Database(':memory:');
        if (db.prepare('select 41+1 as value').get().value !== 42)
            process.exit(1);
        db.close()
    " "$PWD/node_modules/better-sqlite3"
}

package() {
    cd "$_source"

    install -Dm644 \
        dist/linux-unpacked/resources/app.asar \
        "$pkgdir/usr/lib/splayer-next/app.asar"
    cp -a --no-preserve=ownership \
        dist/linux-unpacked/resources/app.asar.unpacked \
        "$pkgdir/usr/lib/splayer-next/"
    cp -a --no-preserve=ownership \
        dist/linux-unpacked/resources/native \
        "$pkgdir/usr/lib/splayer-next/"

    install -Dm755 \
        "$srcdir/splayer-next.sh" \
        "$pkgdir/usr/bin/splayer-next"
    install -Dm644 \
        "$srcdir/top.imsyy.splayer_next.desktop" \
        "$pkgdir/usr/share/applications/top.imsyy.splayer_next.desktop"
    install -Dm644 \
        public/icons/favicon-512x512.png \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/splayer-next.png"
    install -Dm644 \
        LICENSE \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
